variant: openshift
version: 4.21.0
metadata:
  name: 99-master-sysfs-tuning
  labels:
    machineconfiguration.openshift.io/role: master
systemd:
  units:
    - name: sysfs-tuning.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply custom /sys settings
        # After=network.target
        After=network-online.target

        [Service]
        Type=oneshot
        # Replace the paths and echo values with your desired configurations
        ExecStart=/bin/sh -c 'echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor'
        ExecStart=/bin/sh -c 'echo 0 | tee /sys/devices/system/cpu/cpu*/cpufreq/boost'
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
